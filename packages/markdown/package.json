{
  "name": "@kova-ui/markdown",
  "version": "0.1.0-rc.0",
  "description": "Markdown and syntax-highlighted code blocks for Kova UI",
  "license": "MIT",
  "homepage": "https://github.com/matagaralph/kova-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matagaralph/kova-ui.git",
    "directory": "packages/markdown"
  },
  "bugs": {
    "url": "https://github.com/matagaralph/kova-ui/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "kova-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node ../../scripts/build-css.mjs src dist"
  },
  "peerDependencies": {
    "kova-ui": "workspace:^",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react-markdown": "^9.0.3",
    "react-syntax-highlighter": "^16.1.0",
    "remark-breaks": "^4.0.0",
    "remark-directive": "^3.0.1",
    "remark-gfm": "^4.0.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "kova-ui": "workspace:*",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  }
}
