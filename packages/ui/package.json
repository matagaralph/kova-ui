{
  "name": "kova-ui",
  "version": "0.1.0-rc.0",
  "description": "The design system for Amashona",
  "license": "MIT",
  "homepage": "https://github.com/matagaralph/kova-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matagaralph/kova-ui.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/matagaralph/kova-ui/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    "./css": "./dist/styles/index.css",
    "./components": {
      "kova-source": "./src/components/index.ts",
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "default": "./dist/components/*/index.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "default": "./dist/hooks/*.js"
    },
    "./theme": {
      "types": "./dist/lib/theme.d.ts",
      "default": "./dist/lib/theme.js"
    },
    "./helpers": {
      "types": "./dist/lib/helpers.d.ts",
      "default": "./dist/lib/helpers.js"
    },
    "./userAgent": {
      "types": "./dist/lib/userAgent.d.ts",
      "default": "./dist/lib/userAgent.js"
    },
    "./dateUtils": {
      "types": "./dist/lib/dateUtils.d.ts",
      "default": "./dist/lib/dateUtils.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node ../../scripts/build-css.mjs src dist && rsync -a --include='*/' --include='*.d.ts' --include='LICENSE*' --exclude='*' src/ dist/"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "tailwindcss": "^4.0.10",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@kova-ui/icons": "workspace:^",
    "@types/luxon": "3.6.2",
    "clsx": "^2.1.1",
    "luxon": "3.7.1"
  },
  "devDependencies": {
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  }
}
