{
  "name": "kova-ui-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "format": "vp fmt --check '**/*.{js,jsx,ts,tsx,json,css,md}'",
    "format:fix": "vp fmt '**/*.{js,jsx,ts,tsx,json,css,md}'",
    "lint": "pnpm run lint:ts && pnpm run lint:css",
    "lint:ts": "vp lint",
    "lint:css": "stylelint \"packages/*/src/**/*.css\" --ignore-path .stylelintignore",
    "test": "vp test run",
    "types": "tsc",
    "build": "pnpm --filter \"./packages/*\" run build",
    "storybook": "storybook dev -p 6006 --config-dir .storybook-base",
    "build-storybook": "storybook build --disable-telemetry --config-dir .storybook-base"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.14.6",
    "@kova-ui/icons": "workspace:*",
    "@kova-ui/markdown": "workspace:*",
    "@mdx-js/react": "^3.1.0",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-links": "^10.6.1",
    "@storybook/react": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/postcss": "4.0.17",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.20.5",
    "@types/postcss-functions": "4.0.4",
    "@types/postcss-mixins": "9.0.6",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "10.4.20",
    "clsx": "^2.1.1",
    "eslint-plugin-path": "1.4.0-beta.0",
    "happy-dom": "20.14.6",
    "kova-ui": "workspace:*",
    "postcss": "^8.5.29",
    "postcss-functions": "^4.0.2",
    "postcss-mixins": "^11.0.3",
    "postcss-nested": "^7.0.2",
    "postcss-selector-parser": "7.1.6",
    "postcss-value-parser": "4.2.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.6.1",
    "stylelint": "16.18.0",
    "stylelint-config-standard": "^37.0.0",
    "stylelint-order": "^6.0.4",
    "stylelint-scss": "6.12.1",
    "tailwindcss": "4.0.10",
    "typescript": "5.7.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.3.0",
    "vitest": "5.0.3"
  }
}
